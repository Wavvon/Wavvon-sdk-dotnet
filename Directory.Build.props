<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>The Wavvon contributors</Authors>
    <Copyright>Copyright 2026 The Wavvon contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Wavvon/Wavvon-docs/blob/main/docs/sdk.md</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Wavvon/Wavvon-sdk-dotnet</RepositoryUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
