<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Lets the net8.0 build run where only a newer runtime is installed. -->
    <RollForward>Major</RollForward>
    <NoWarn>$(NoWarn);CA1707;CA1861;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Wavvon.Sdk/Wavvon.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
